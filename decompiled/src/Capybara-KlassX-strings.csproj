<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>Capybara-KlassX</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- resx มี resource ที่ไม่ใช่ string (รูป/ไอคอน) → dotnet build ต้องใช้โหมดนี้ -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="runtime.js" />
    <None Remove="ThirdParty.Pillow-LICENSE.txt" />
    <None Remove="costura.costura.dll.compressed" />
    <None Remove="costura.costura.pdb.compressed" />
    <None Remove="costura.newtonsoft.json.dll.compressed" />
    <None Remove="costura.metadata" />
    <None Remove="Eazfuscator.NET.Runtime.Licensing.WindowsForms.Error.png" />
    <None Remove="-" />
    <EmbeddedResource Include="runtime.js" LogicalName="runtime.js" />
    <EmbeddedResource Include="ThirdParty.Pillow-LICENSE.txt" LogicalName="ThirdParty.Pillow-LICENSE.txt" />
    <EmbeddedResource Include="costura.costura.dll.compressed" LogicalName="costura.costura.dll.compressed" />
    <EmbeddedResource Include="costura.costura.pdb.compressed" LogicalName="costura.costura.pdb.compressed" />
    <EmbeddedResource Include="costura.newtonsoft.json.dll.compressed" LogicalName="costura.newtonsoft.json.dll.compressed" />
    <EmbeddedResource Include="costura.metadata" LogicalName="costura.metadata" />
    <EmbeddedResource Include="Eazfuscator.NET.Runtime.Licensing.WindowsForms.Error.png" LogicalName="Eazfuscator.NET.Runtime.Licensing.WindowsForms.Error.png" />
    <EmbeddedResource Include="-" LogicalName="              " />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <!-- แตกจาก costura.newtonsoft.json.dll.compressed (SHA1 ตรงกับ costura.metadata) -->
      <HintPath>..\lib\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="System.Core" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- exe ตรวจ config\klx.dll (native bridge) ตอนเปิด และ push config\klxsvc เข้า emulator -->
    <None Include="..\..\config\klx.dll" Link="config\klx.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\config\klxsvc" Link="config\klxsvc" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- ตาราง offset (เดิมได้จาก license server ตอน /login) → LocalOffsets.cs -->
    <None Include="..\..\config\offsets.json" Link="config\offsets.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- OneOCR ตัวอ่าน captcha: เก็บไว้ที่ src\OCR (ไม่เข้า git) → build ก๊อปไปที่ OneOCR\ ข้าง exe (Class131.smethod_8 / Class136)
         ก๊อปแค่ 3 ไฟล์นี้ — ไฟล์อื่นในโฟลเดอร์ OneOCR ทำให้ test-product-layout ไม่ผ่าน -->
    <None Remove="OCR\**" />
    <None Include="OCR\oneocr.dll;OCR\oneocr.onemodel;OCR\onnxruntime.dll" Condition="Exists('OCR\oneocr.dll')" Link="OneOCR\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>